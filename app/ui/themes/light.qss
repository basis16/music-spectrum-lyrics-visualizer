/* Music Spectrum Lyric Video Maker - Light theme.
   Single harmonious palette:
     bg-base    #F4F6FB   window/page background
     bg-surface #FFFFFF   cards, inputs
     bg-soft    #EEF1F8   hover, selection bg
     border     #DCE1EC   hairline borders
     border-on  #C6CCDB   stronger borders (focus rings)
     text       #14192A   primary text
     text-muted #56607A   secondary text
     text-faint #8A93A8
     accent     #4263FF   primary action / selection
     accent-on  #2E4CEB   pressed / hover-darker
     accent-bg  #E5EAFF   selection / soft accent surface
     success    #1F8B49
     warning    #B5780A
     danger     #D63838
     log-bg     #131726   code/log panel background
     log-text   #D1D9F1
*/

* {
    font-family: "Segoe UI", "Inter", "Helvetica Neue", "Arial", sans-serif;
    color: #14192A;
}

QLabel[role="muted"] {
    color: #56607A;
    font-weight: 500;
}

QLabel#PreviewFrame {
    background-color: #0E1220;
    border-radius: 12px;
    border: 1px solid #DCE1EC;
}

QMainWindow, QWidget, QDialog {
    background-color: #F4F6FB;
}

/* Status bar / tool tips */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #DCE1EC;
    color: #56607A;
    padding: 4px 8px;
}
QToolTip {
    background-color: #14192A;
    color: #F4F6FB;
    border: 1px solid #14192A;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------- Sidebar ---------- */
QListWidget#Sidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #DCE1EC;
    padding: 12px 8px;
    outline: none;
}
QListWidget#Sidebar::item {
    padding: 12px 14px;
    margin: 3px 4px;
    border-radius: 10px;
    color: #56607A;
    font-weight: 600;
    font-size: 14px;
}
QListWidget#Sidebar::item:hover {
    background-color: #EEF1F8;
    color: #4263FF;
}
QListWidget#Sidebar::item:selected {
    background-color: #4263FF;
    color: #FFFFFF;
}

/* ---------- Cards & group boxes ---------- */
QFrame#Card, QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DCE1EC;
    border-radius: 14px;
}
QGroupBox {
    margin-top: 18px;
    padding: 22px 14px 14px 14px;
    font-weight: 600;
    color: #14192A;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 6px;
    color: #4263FF;
    background-color: #FFFFFF;
}

/* ---------- Inputs ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox,
QPlainTextEdit, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #DCE1EC;
    border-radius: 8px;
    padding: 6px 10px;
    color: #14192A;
    selection-background-color: #4263FF;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QPlainTextEdit:focus, QTextEdit:focus {
    border: 1px solid #4263FF;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #F4F6FB;
    color: #8A93A8;
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #DCE1EC;
    selection-background-color: #EEF1F8;
    selection-color: #14192A;
    padding: 4px;
    outline: none;
}

/* ---------- Buttons ---------- */
QPushButton {
    background-color: #4263FF;
    color: #FFFFFF;
    border: 1px solid #4263FF;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: 600;
    min-height: 22px;
}
QPushButton:hover {
    background-color: #2E4CEB;
    border-color: #2E4CEB;
}
QPushButton:pressed {
    background-color: #2842CF;
    border-color: #2842CF;
}
QPushButton:disabled {
    background-color: #C6CCDB;
    color: #FFFFFF;
    border-color: #C6CCDB;
}
QPushButton[role="secondary"] {
    background-color: #FFFFFF;
    color: #4263FF;
    border: 1px solid #DCE1EC;
}
QPushButton[role="secondary"]:hover {
    background-color: #EEF1F8;
    border-color: #C6CCDB;
}
QPushButton[role="secondary"]:disabled {
    background-color: #FFFFFF;
    color: #C6CCDB;
    border-color: #DCE1EC;
}
QPushButton[role="danger"] {
    background-color: #D63838;
    border-color: #D63838;
}
QPushButton[role="danger"]:hover {
    background-color: #BD2C2C;
    border-color: #BD2C2C;
}

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
    height: 6px;
    background: #DCE1EC;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #4263FF;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #4263FF;
    width: 16px;
    height: 16px;
    margin: -7px 0;
    border-radius: 9px;
}
QSlider::handle:horizontal:hover {
    background: #4263FF;
}

/* ---------- Checkboxes / Radio ---------- */
QCheckBox, QRadioButton {
    spacing: 6px;
    color: #14192A;
}
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C6CCDB;
    background-color: #FFFFFF;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: #4263FF;
}
QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #4263FF;
    border-color: #4263FF;
}

/* ---------- Progress bars ---------- */
QProgressBar {
    border: 1px solid #DCE1EC;
    border-radius: 8px;
    background-color: #FFFFFF;
    text-align: center;
    color: #14192A;
    height: 18px;
}
QProgressBar::chunk {
    background-color: #4263FF;
    border-radius: 7px;
}

/* ---------- Tables / Trees ---------- */
QTableWidget, QTreeWidget, QTableView, QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #DCE1EC;
    border-radius: 10px;
    gridline-color: #EEF1F8;
    selection-background-color: #E5EAFF;
    selection-color: #14192A;
    alternate-background-color: #F8FAFD;
}
QHeaderView::section {
    background-color: #F4F6FB;
    border: none;
    border-bottom: 1px solid #DCE1EC;
    padding: 6px 8px;
    font-weight: 600;
    color: #56607A;
}

/* ---------- Scroll bars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 4px 2px;
}
QScrollBar::handle:vertical {
    background: #C6CCDB;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #8A93A8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none; border: none; height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px 4px;
}
QScrollBar::handle:horizontal {
    background: #C6CCDB;
    border-radius: 5px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover { background: #8A93A8; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    background: none; border: none; width: 0;
}

/* ---------- Splitter handle ---------- */
QSplitter::handle {
    background-color: #DCE1EC;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* ---------- Dock widgets ---------- */
QDockWidget {
    color: #14192A;
}
QDockWidget::title {
    background-color: #F4F6FB;
    border-bottom: 1px solid #DCE1EC;
    padding: 6px 10px;
    font-weight: 600;
    color: #56607A;
}

/* ---------- Log panel ---------- */
QPlainTextEdit#LogPanel {
    background-color: #131726;
    color: #D1D9F1;
    font-family: "Consolas", "Cascadia Mono", "Courier New", monospace;
    border: 1px solid #131726;
    border-radius: 12px;
    padding: 8px;
    selection-background-color: #4263FF;
    selection-color: #FFFFFF;
}
