/* Dark theme variant. */

* {
    font-family: "Segoe UI", "Inter", "Arial", sans-serif;
    color: #e3e8f3;
}

QMainWindow, QWidget {
    background-color: #11151c;
}

QStatusBar {
    background-color: #161b25;
    border-top: 1px solid #1f2735;
    color: #aab3c6;
}

QListWidget#Sidebar {
    background-color: #161b25;
    border: none;
    border-right: 1px solid #1f2735;
    padding: 12px 6px;
    outline: none;
}
QListWidget#Sidebar::item {
    padding: 12px 14px;
    margin: 2px 6px;
    border-radius: 10px;
    color: #aab3c6;
    font-weight: 600;
    font-size: 14px;
}
QListWidget#Sidebar::item:hover {
    background-color: #1d2433;
    color: #6da7ff;
}
QListWidget#Sidebar::item:selected {
    background-color: #2a55ff;
    color: #ffffff;
}

QFrame#Card, QGroupBox {
    background-color: #161b25;
    border: 1px solid #1f2735;
    border-radius: 14px;
}
QGroupBox {
    margin-top: 18px;
    padding-top: 18px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    top: 4px;
    padding: 0 6px;
    color: #6da7ff;
    background-color: #161b25;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QPlainTextEdit, QTextEdit {
    background-color: #1c2331;
    border: 1px solid #2a3245;
    border-radius: 8px;
    padding: 6px 10px;
    color: #e3e8f3;
    selection-background-color: #2a55ff;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #2a55ff;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 8px 18px;
    font-weight: 600;
}
QPushButton:hover { background-color: #4470ff; }
QPushButton[role="secondary"] {
    background-color: #1c2331;
    color: #6da7ff;
    border: 1px solid #2a3245;
}
QPushButton[role="danger"] {
    background-color: #e64a4a;
}

QSlider::groove:horizontal {
    height: 6px;
    background: #1f2735;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #2a55ff;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #2a55ff;
    border-radius: 3px;
}

QProgressBar {
    border: 1px solid #2a3245;
    border-radius: 8px;
    background-color: #1c2331;
    text-align: center;
    color: #e3e8f3;
    height: 18px;
}
QProgressBar::chunk {
    background-color: #2a55ff;
    border-radius: 7px;
}

QTableWidget, QTreeWidget {
    background-color: #161b25;
    border: 1px solid #1f2735;
    gridline-color: #1f2735;
    selection-background-color: #1d2433;
    selection-color: #e3e8f3;
}
QHeaderView::section {
    background-color: #1c2331;
    border: none;
    border-bottom: 1px solid #2a3245;
    padding: 6px 8px;
    font-weight: 600;
    color: #aab3c6;
}

QPlainTextEdit#LogPanel {
    background-color: #0c0f15;
    color: #d3e1ff;
    font-family: "Consolas", "Cascadia Mono", monospace;
    border: 1px solid #1c2331;
    border-radius: 12px;
    padding: 8px;
}
